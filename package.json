{
  "name": "dsh-plugin-guard-cli",
  "version": "0.1.0",
  "description": "Security governance and admission layer for DSH (DeepSeek Harness) plugins: one-command scan, dsh.permissions manifest spec, trust index, runtime audit adapter.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "security",
    "supply-chain",
    "permissions",
    "audit",
    "scan",
    "cli"
  ],
  "license": "MIT",
  "author": "RyeSama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyeSama/dsh-plugin-guard.git"
  },
  "homepage": "https://github.com/RyeSama/dsh-plugin-guard#readme",
  "bugs": {
    "url": "https://github.com/RyeSama/dsh-plugin-guard/issues"
  },
  "type": "module",
  "bin": {
    "dsh-plugin-guard": "dist/cli.js",
    "dsh-guard": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts plugins/dsh-guard-tool",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run plugins:test",
    "prepublishOnly": "npm run verify",
    "plugins:test": "node plugins/dsh-guard-tool/scripts/dev-link.mjs && node --test plugins/dsh-guard-tool/test/smoke.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@types/node": "^22.10.0",
    "commander": "^15.0.0",
    "oxlint": "^1.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "zod": "^3.25.0"
  }
}
